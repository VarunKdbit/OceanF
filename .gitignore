# ==============================
# OceanF Git Ignore
# ==============================

# Scientific data files
*.nc
*.nc4
*.h5
*.hdf5
*.grib
*.grib2
*.zarr

# Raw data
data/raw/

# Processed scientific datasets
data/processed/**/*.nc
data/processed/**/*.nc4
data/processed/**/*.h5
data/processed/**/*.hdf5
data/processed/**/*.zarr

# ML training artifacts
data/processed/ML/checkpoints/
data/processed/ML/baselines/
data/processed/ML/evaluation/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python environments
.venv/
venv/
.venv312/
env/

# Python packaging
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Java / Maven
**/target/
*.class

# Logs
*.log

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
frontend/node_modules/
frontend-temp/


frontend/node_modules/
frontend-temp/


# Runtime cache lock
data/processed/live/.daily-cache.lock
